#!/usr/bin/env bash
# =============================================================================
#  cloudpc-password - view or change the desktop login password.
#
#  Usage (root, e.g. via `railway ssh` / `docker exec -it <container> bash`):
#
#     cloudpc-password show              print the current password
#     cloudpc-password set               prompt for a new password
#     cloudpc-password set 'MySecret'    set it non-interactively
#     cloudpc-password rotate-sessions   log out every browser
#     cloudpc-password status            where the password comes from
#
#  The password protects the browser login page. Changing it also invalidates
#  every existing session cookie and the stored VNC password is rotated with it.
# =============================================================================
set -Eeuo pipefail

CLOUDPC_ROOT="${CLOUDPC_ROOT:-/opt/cloudpc}"
# shellcheck source=../lib/common.sh
. "${CLOUDPC_ROOT}/lib/common.sh"

[ "$(id -u)" = "0" ] || die "run this as root (railway ssh, then: cloudpc-password $*)"

DESKTOP_USER="${DESKTOP_USER:-ubuntu}"
RUN_DIR="${CLOUDPC_RUN_DIR:-/run/cloudpc}"
DATA_DIR="${RAILWAY_VOLUME_MOUNT_PATH:-${CLOUDPC_DATA_DIR:-/data}}"
SECRETS_DIR="${DATA_DIR}/.secrets"
# Fall back to the runtime directory when there is no persistent volume.
if ! mountpoint -q "${DATA_DIR}" 2>/dev/null && [ ! -w "${SECRETS_DIR}" ] 2>/dev/null; then
    SECRETS_DIR="${RUN_DIR}/secrets"
fi
PASSWORD_FILE="${SECRETS_DIR}/desktop_password"
AUTH_FILE="${RUN_DIR}/auth.json"
SESSION_KEY="${RUN_DIR}/session.key"
VNC_PASSWORD_FILE="${RUN_DIR}/vnc_password"
VNC_RUNTIME="${RUN_DIR}/vnc"
SUPERVISOR_CONF="${CLOUDPC_ROOT}/supervisor/supervisord.conf"

generate_password() {
    python3 - <<'PY'
import secrets
alphabet = "abcdefghjkmnpqrstuvwxyz23456789"
print("-".join("".join(secrets.choice(alphabet) for _ in range(5)) for _ in range(4)))
PY
}

generate_vnc_password() {
    python3 - <<'PY'
import secrets
# VNC authentication is DES based, so anything past eight characters is
# ignored - eight random characters from a 62 character alphabet is the most
# entropy the scheme can carry.
alphabet = "abcdefghijkmnopqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789"
print("".join(secrets.choice(alphabet) for _ in range(8)))
PY
}

write_hash() {
    local password="$1"
    CLOUDPC_PASSWORD_FOR_HASH="${password}" python3 - "${AUTH_FILE}" "${DESKTOP_USER}" <<'PY'
import base64, hashlib, json, os, secrets, sys

path, user = sys.argv[1], sys.argv[2]
password = os.environ["CLOUDPC_PASSWORD_FOR_HASH"].encode()
salt = secrets.token_bytes(16)
digest = hashlib.scrypt(password, salt=salt, n=16384, r=8, p=1, dklen=32)
record = {
    "username": user,
    "algorithm": "scrypt",
    "n": 16384, "r": 8, "p": 1, "dklen": 32,
    "salt": base64.b64encode(salt).decode(),
    "hash": base64.b64encode(digest).decode(),
}
tmp = path + ".tmp"
with open(tmp, "w", encoding="utf-8") as handle:
    json.dump(record, handle)
os.replace(tmp, path)
os.chmod(path, 0o644)
PY
    export -n CLOUDPC_PASSWORD_FOR_HASH 2>/dev/null || true
}

rotate_session_key() {
    local tmp
    tmp="$(mktemp)"
    python3 - "$tmp" <<'PY'
import base64, os, secrets, sys
raw = secrets.token_bytes(32)
with open(sys.argv[1], "w", encoding="ascii") as handle:
    handle.write(base64.urlsafe_b64encode(raw).decode())
PY
    install -o root -g cloudpc -m 0640 "${tmp}" "${SESSION_KEY}"
    rm -f "${tmp}"
}

rotate_vnc_password() {
    local password="$1"
    install -d -m 0750 -o "${DESKTOP_USER}" -g "${DESKTOP_USER}" "${VNC_RUNTIME}"
    printf '%s' "${password}" > "${VNC_PASSWORD_FILE}.tmp"
    install -o root -g cloudpc -m 0640 "${VNC_PASSWORD_FILE}.tmp" "${VNC_PASSWORD_FILE}"
    rm -f "${VNC_PASSWORD_FILE}.tmp"
    printf '%s\n' "${password}" | vncpasswd -f > "${VNC_RUNTIME}/passwd.tmp"
    install -o "${DESKTOP_USER}" -g "${DESKTOP_USER}" -m 0600 \
        "${VNC_RUNTIME}/passwd.tmp" "${VNC_RUNTIME}/passwd"
    rm -f "${VNC_RUNTIME}/passwd.tmp"
}

restart_gateway() {
    if [ -S /run/supervisor.sock ]; then
        supervisorctl -c "${SUPERVISOR_CONF}" restart gateway || warn "could not restart the gateway"
    else
        warn "supervisord is not running - restart the container to apply the change"
    fi
}

case "${1:-show}" in
    show)
        if [ -n "${DESKTOP_PASSWORD:-}" ]; then
            echo "The DESKTOP_PASSWORD service variable is set; that value is in use."
            echo "(Unset it in the Railway dashboard to fall back to the stored password.)"
            exit 0
        fi
        if [ -r "${PASSWORD_FILE}" ]; then
            echo "user     : ${DESKTOP_USER}"
            echo "password : $(cat "${PASSWORD_FILE}")"
        else
            die "no stored password found at ${PASSWORD_FILE}"
        fi
        ;;

    status)
        echo "stored password file : ${PASSWORD_FILE}"
        [ -r "${PASSWORD_FILE}" ] && echo "                       (present)" \
            || echo "                       (absent)"
        echo "service variable     : ${DESKTOP_PASSWORD:+DESKTOP_PASSWORD is set (takes priority)}"
        [ -z "${DESKTOP_PASSWORD:-}" ] && echo "                       (not set)"
        echo "session key          : ${SESSION_KEY}"
        echo "auth hash            : ${AUTH_FILE}"
        ;;

    set)
        NEW_PASSWORD="${2:-}"
        if [ -z "${NEW_PASSWORD}" ]; then
            printf 'New desktop password (min 12 characters): '
            read -r -s NEW_PASSWORD
            printf '\nRepeat: '
            read -r CONFIRM
            [ "${NEW_PASSWORD}" = "${CONFIRM}" ] || die "the passwords do not match"
            printf '\n'
        fi
        [ "${#NEW_PASSWORD}" -ge 12 ] || die "use at least 12 characters"
        case "${NEW_PASSWORD}" in
            *[![:print:]]*) die "use printable characters only" ;;
        esac

        install -d -m 0700 -o root -g root "${SECRETS_DIR}"
        umask 077
        printf '%s' "${NEW_PASSWORD}" > "${PASSWORD_FILE}"
        chmod 0600 "${PASSWORD_FILE}"
        printf '%s:%s\n' "${DESKTOP_USER}" "${NEW_PASSWORD}" | chpasswd
        write_hash "${NEW_PASSWORD}"
        rotate_session_key
        rotate_vnc_password "$(generate_vnc_password)"
        restart_gateway
        unset NEW_PASSWORD CONFIRM

        banner \
            "DESKTOP PASSWORD CHANGED" \
            "" \
            "  Username : ${DESKTOP_USER}" \
            "  Password : (hidden)" \
            "  Storage  : ${PASSWORD_FILE}" \
            "" \
            "  Every browser was signed out. If the DESKTOP_PASSWORD service" \
            "  variable is set, it still overrides this stored password."
        ;;

    rotate-sessions)
        rotate_session_key
        restart_gateway
        log "every session cookie is now invalid"
        ;;

    -h|--help|help)
        sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
        ;;

    *)
        die "unknown command '${1}' - try: cloudpc-password show|set|rotate-sessions|status"
        ;;
esac
