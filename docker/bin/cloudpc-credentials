#!/usr/bin/env bash
# =============================================================================
#  Print the remote desktop connection details.
#  Root only: the password file is mode 0600 and owned by root.
#  Intended for `railway ssh` / `docker exec` style administrative access.
# =============================================================================
set -Eeuo pipefail

CLOUDPC_ROOT="${CLOUDPC_ROOT:-/opt/cloudpc}"
# shellcheck source=../lib/common.sh
. "${CLOUDPC_ROOT}/lib/common.sh"

SHOW_PASSWORD=true
PASSWORD_ONLY=false
for arg in "$@"; do
    case "$arg" in
        --no-password)   SHOW_PASSWORD=false ;;
        --password-only) PASSWORD_ONLY=true ;;
        -h|--help)
            echo "usage: cloudpc-credentials [--no-password] [--password-only]"
            exit 0 ;;
    esac
done

RUNTIME_FILE="/run/cloudpc/runtime.json"
[ -r "${RUNTIME_FILE}" ] || die "runtime information not found - is the container finished starting?"

get() { python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get(sys.argv[2],""))' "${RUNTIME_FILE}" "$1"; }

USERNAME="$(get username)"
DATA_DIR="$(get data_dir)"
PERSISTENT="$(get persistent)"
RDP_PORT="$(get rdp_port)"
PROXY_DOMAIN="$(get tcp_proxy_domain)"
PROXY_PORT="$(get tcp_proxy_port)"
SOURCE="$(get password_source)"

if [ "${PERSISTENT}" = "True" ]; then
    PASSWORD_FILE="${DATA_DIR}/.secrets/rdp_password"
else
    PASSWORD_FILE="/run/cloudpc/secrets/rdp_password"
fi

PASSWORD="(set through the RDP_PASSWORD variable - not stored on disk)"
if [ -r "${PASSWORD_FILE}" ]; then
    PASSWORD="$(cat "${PASSWORD_FILE}")"
elif [ "$(id -u)" != "0" ]; then
    PASSWORD="(unreadable - run this command as root)"
fi

if [ "${PASSWORD_ONLY}" = true ]; then
    printf '%s\n' "${PASSWORD}"
    exit 0
fi

if [ -n "${PROXY_DOMAIN}" ] && [ -n "${PROXY_PORT}" ]; then
    ADDRESS="${PROXY_DOMAIN}:${PROXY_PORT}"
else
    ADDRESS="(no Railway TCP Proxy yet - create one for internal port ${RDP_PORT})"
fi

if [ "${SHOW_PASSWORD}" = true ]; then
    banner \
        "UBUNTU CLOUD PC - CONNECTION DETAILS" \
        "" \
        "  RDP address : ${ADDRESS}" \
        "  Username    : ${USERNAME}" \
        "  Password    : ${PASSWORD}" \
        "  Source      : ${SOURCE}"
else
    banner \
        "UBUNTU CLOUD PC - CONNECTION DETAILS" \
        "" \
        "  RDP address : ${ADDRESS}" \
        "  Username    : ${USERNAME}" \
        "  Password    : (hidden)"
fi
