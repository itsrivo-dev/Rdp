#!/usr/bin/env bash
# =============================================================================
#  cloudpc-health - single-shot health probe.
#
#    exit 0 -> the web gateway is serving and the display server is listening
#    exit 1 -> something needed for a usable desktop is down
#
#  Used by the Docker/Railway healthcheck, the watchdog and the test suite.
#
#  Options:
#    --quiet     no output, exit code only
#    --json      machine readable output
#    --strict    also require a running XFCE session (not just the display)
# =============================================================================
set -uo pipefail

CLOUDPC_ROOT="${CLOUDPC_ROOT:-/opt/cloudpc}"
# shellcheck source=../lib/common.sh
. "${CLOUDPC_ROOT}/lib/common.sh"

QUIET=false
JSON=false
STRICT=false
for arg in "$@"; do
    case "${arg}" in
        -q|--quiet)  QUIET=true ;;
        -j|--json)   JSON=true ;;
        -s|--strict) STRICT=true ;;
        -h|--help)   sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "unknown option: ${arg}" >&2; exit 2 ;;
    esac
done

HTTP_PORT="${PORT:-8080}"
VNC_PORT="${VNC_PORT:-5900}"
desktop_user="${DESKTOP_USER:-ubuntu}"

rc=0
status_gateway=ok
http_ok "${HTTP_PORT}" /health                 || { status_gateway=down;   rc=1; }
status_vnc=ok
port_listening "${VNC_PORT}"                   || { status_vnc=down;       rc=1; }
status_bus=ok
[ -S /run/dbus/system_bus_socket ]             || status_bus=down
status_session=ok
if ! pgrep -u "${desktop_user}" -x xfce4-session >/dev/null 2>&1; then
    status_session=starting
    [ "${STRICT}" = true ] && rc=1
fi

if [ "${JSON}" = true ]; then
    printf '{"gateway":"%s","vnc":"%s","dbus":"%s","session":"%s","healthy":%s}\n' \
        "${status_gateway}" "${status_vnc}" "${status_bus}" "${status_session}" \
        "$([ "${rc}" -eq 0 ] && echo true || echo false)"
elif [ "${QUIET}" != true ]; then
    printf 'gateway(%s)=%s  vnc(%s)=%s  dbus=%s  session=%s\n' \
        "${HTTP_PORT}" "${status_gateway}" "${VNC_PORT}" "${status_vnc}" \
        "${status_bus}" "${status_session}"
fi

exit "${rc}"
