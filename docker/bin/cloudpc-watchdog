#!/usr/bin/env bash
# =============================================================================
#  cloudpc-watchdog - keep the desktop stack alive without creating restart
#  loops.
#
#  Every CLOUDPC_WATCHDOG_INTERVAL seconds it probes the display server, the
#  web gateway and the XFCE session. A probe that fails twice in a row is
#  restarted through supervisord - but only a limited number of times: after
#  that the watchdog logs a loud error and stops retrying, so a broken image
#  reports itself instead of burning CPU away.
# =============================================================================
set -uo pipefail

CLOUDPC_ROOT="${CLOUDPC_ROOT:-/opt/cloudpc}"
# shellcheck source=../lib/common.sh
. "${CLOUDPC_ROOT}/lib/common.sh"

INTERVAL="${CLOUDPC_WATCHDOG_INTERVAL:-30}"
GRACE="${CLOUDPC_WATCHDOG_GRACE:-45}"
MAX_RESTARTS="${CLOUDPC_WATCHDOG_MAX_RESTARTS:-3}"
HTTP_PORT="${PORT:-8080}"
VNC_PORT="${VNC_PORT:-5900}"
DESKTOP_USER="${DESKTOP_USER:-ubuntu}"
SUPERVISOR_CONF="${CLOUDPC_ROOT}/supervisor/supervisord.conf"

declare -A FAILURES=( [vnc]=0 [session]=0 [gateway]=0 )
declare -A RESTARTS=( [vnc]=0 [session]=0 [gateway]=0 )
declare -A GAVE_UP=( [vnc]=0 [session]=0 [gateway]=0 )

running=true
shutdown() { running=false; }
trap shutdown TERM INT

probe_vnc()     { port_listening "${VNC_PORT}"; }
probe_session() { pgrep -u "${DESKTOP_USER}" -x xfce4-session >/dev/null 2>&1; }
probe_gateway() { port_listening "${HTTP_PORT}" && http_ok "${HTTP_PORT}" /health; }

restart_program() {
    local program="$1"
    if [ "${GAVE_UP[$program]}" = 1 ]; then
        return
    fi
    if [ "${RESTARTS[$program]}" -ge "${MAX_RESTARTS}" ]; then
        GAVE_UP[$program]=1
        err "watchdog: ${program} keeps failing - giving up after ${MAX_RESTARTS} restarts."
        err "watchdog: check 'cloudpc-status' and the container logs; the process will not be"
        err "watchdog: restarted again until the container itself is restarted."
        return
    fi
    RESTARTS[$program]=$(( RESTARTS[$program] + 1 ))
    warn "watchdog: restarting ${program} (attempt ${RESTARTS[$program]}/${MAX_RESTARTS})"
    if supervisorctl -c "${SUPERVISOR_CONF}" restart "${program}" >/dev/null 2>&1; then
        log "watchdog: ${program} restarted"
    else
        err "watchdog: supervisorctl could not restart ${program}"
    fi
}

log "watchdog started (interval ${INTERVAL}s, grace ${GRACE}s, max ${MAX_RESTARTS} restarts per program)"
sleep "${GRACE}"

while [ "${running}" = true ]; do
    for program in vnc gateway session; do
        if "probe_${program}"; then
            if [ "${FAILURES[$program]}" -ne 0 ]; then
                log "watchdog: ${program} recovered"
            fi
            FAILURES[$program]=0
            continue
        fi
        FAILURES[$program]=$(( FAILURES[$program] + 1 ))
        warn "watchdog: ${program} probe failed (${FAILURES[$program]}/2)"
        if [ "${FAILURES[$program]}" -ge 2 ]; then
            restart_program "${program}"
            FAILURES[$program]=0
        fi
    done

    # Sleep in one-second slices so SIGTERM is handled immediately.
    for _ in $(seq 1 "${INTERVAL}"); do
        [ "${running}" = true ] || break
        sleep 1
    done
done

log "watchdog stopped"
exit 0
