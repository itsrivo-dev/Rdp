; =============================================================================
;  xrdp.ini - rendered at container start by /opt/cloudpc/entrypoint.sh
;  Placeholders in the form of double-at tokens are substituted from the
;  runtime environment before xrdp starts.
; =============================================================================
[Globals]
ini_version=1
fork=true
port=@@RDP_PORT@@
use_vsock=false
tcp_nodelay=true
tcp_keepalive=true

; --- Security -----------------------------------------------------------
; negotiate => use TLS when the client supports it (all modern Android RDP
; clients do), never fall back to an unencrypted layer below RDP standard
; encryption. crypt_level=high forces 128-bit RDP encryption.
security_layer=negotiate
crypt_level=high
certificate=@@TLS_CERT@@
key_file=@@TLS_KEY@@
ssl_protocols=TLSv1.2, TLSv1.3
tls_ciphers=HIGH

; --- Session behaviour --------------------------------------------------
; autorun points every login straight at the XFCE session definition below,
; so no session-type picker is shown on small phone screens.
autorun=Ubuntu-Desktop
allow_channels=true
allow_multimon=false
bitmap_cache=true
bitmap_compression=true
bulk_compression=true
max_bpp=@@RDP_MAX_BPP@@
new_cursors=true
use_fastpath=both
hidelogwindow=false

; --- Login screen -------------------------------------------------------
ls_title=Ubuntu Cloud PC
ls_top_window_bg_color=2c3e50
ls_width=350
ls_height=380
ls_bg_color=dedede
ls_label_y_pos=200
ls_input_y_pos=220
ls_btn_ok_y_pos=300
ls_btn_cancel_y_pos=300

[Logging]
LogFile=/var/log/xrdp/xrdp.log
LogLevel=INFO
EnableSyslog=false
EnableConsole=true
ConsoleLevel=INFO

[Channels]
; Clipboard sharing between the phone and the desktop.
cliprdr=true
drdynvc=true
; Drive redirection needs FUSE (/dev/fuse), which managed container platforms
; such as Railway do not grant - leaving it on only produces mount errors.
rdpdr=false
; No audio stack is installed (keeps the image small and the CPU idle).
rdpsnd=false
rail=false
xrdpvr=false
tcutils=false

; =============================================================================
;  Session definition: XFCE on a TigerVNC X server managed by xrdp-sesman.
;  Xvnc is used instead of Xorg because it needs no VT, no /dev/dri and no
;  elevated capabilities - the only backend that works reliably inside an
;  unprivileged container.
; =============================================================================
[Ubuntu-Desktop]
name=Ubuntu Desktop (XFCE)
lib=libvnc.so
username=ask
password=ask
ip=127.0.0.1
port=-1
xserverbpp=24
delay_ms=2000
